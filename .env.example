# 数据根目录：SQLite 数据库与上传文件都存在这里（Docker 部署用 /data 并挂载 volume）
DATA_DIR=./data

# 会话与分享访问令牌的签名密钥，必填，至少 32 字符。生成：openssl rand -base64 48
SESSION_SECRET=

# 上传文件大小上限（MB）
MAX_FILE_SIZE_MB=50

# 每个可存储 HTML 的共享 JSON 数据大小上限（KB，只保留最新快照）
MAX_PAGE_STATE_SIZE_KB=256

# 访客附件配额：单文件 / 每个分享总量 / 每个访客在该分享内总量（MB）
ATTACHMENT_MAX_FILE_MB=10
ATTACHMENT_MAX_SHARE_MB=100
ATTACHMENT_MAX_VISITOR_MB=20

# 站点对外地址，用于生成分享链接和上传/共享数据写入接口的 Origin 校验；
# 同时决定 cookie 的 Secure 标志（https 才加），须与浏览器访问地址协议一致
APP_URL=http://localhost:3000

# 部署在反向代理（nginx/caddy）之后时设为 1，从 x-forwarded-for 获取真实 IP（用于限流）
TRUST_PROXY=0

# 页面内 LLM（可选）：OpenAI 兼容 /chat/completions 上游。
# 配好后 MCP 工具 set_llm_enabled 才能启用；不配则该能力整体不可用。
# DeepSeek 示例：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_DEFAULT_MODEL=deepseek-chat        # 或 deepseek-reasoner
# LLM_MAX_TOKENS=1024
# LLM_DEFAULT_DAILY_BUDGET=50000          # 每 share 每日 token 配额（可在 share 级覆盖）
